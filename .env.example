# ==============================================
# Assistudy Backend - 환경변수 템플릿
# .env 파일로 복사 후 값을 채워주세요:
#   cp .env.example .env
# ==============================================

# Spring Profile (local | dev | prod)
SPRING_PROFILES_ACTIVE=local

# Eureka
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=eureka
# 로컬 실행 시: http://eureka:eureka@localhost:8761/eureka
# Docker 서비스 간: http://eureka:eureka@discovery-service:8761/eureka
EUREKA_SERVER_URL=http://${EUREKA_USERNAME}:${EUREKA_PASSWORD}@localhost:8761/eureka

# ────────────────────────────────────────────
# MySQL
# ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your-root-password

# Common DB
MYSQL_COMMON_HOST=localhost
MYSQL_COMMON_PORT=3306
MYSQL_COMMON_DB=assistudy_common

# User DB
MYSQL_USER_HOST=localhost
MYSQL_USER_PORT=3307
MYSQL_USER_DB=assistudy_user

# Log DB
MYSQL_LOG_HOST=localhost
MYSQL_LOG_PORT=3308
MYSQL_LOG_DB=assistudy_log

# Homework DB
MYSQL_HOMEWORK_HOST=localhost
MYSQL_HOMEWORK_PORT=3309
MYSQL_HOMEWORK_DB=assistudy_homework

# 공통 DB 계정
MYSQL_DB_USER=assistudy
MYSQL_DB_PASSWORD=your-db-password

# ────────────────────────────────────────────
# Redis
# ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ────────────────────────────────────────────
# Kafka
# ────────────────────────────────────────────
# 서비스가 Kafka에 연결할 주소
# 로컬: localhost:9103 / EC2 prod: {KAFKA_EC2_PRIVATE_IP}:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9103

# docker-compose.infra.yml (Kafka 브로커 설정)
# 로컬: 기본값 그대로 사용 (생략 가능)
# Kafka EC2: KAFKA_ADVERTISED_HOST={EC2_PRIVATE_IP}, KAFKA_EXTERNAL_PORT=9092
KAFKA_ADVERTISED_HOST=host.docker.internal
KAFKA_EXTERNAL_PORT=9103

# ────────────────────────────────────────────
# JWT
# ────────────────────────────────────────────
# PEM 헤더/푸터 없이 base64만 (openssl로 추출):
#   grep -v "BEGIN\|END" private_key_pkcs8.pem | tr -d '\n\r'
#   grep -v "BEGIN\|END" public_key.pem | tr -d '\n\r'
JWT_PRIVATE_KEY=your-base64-private-key
JWT_PUBLIC_KEY=your-base64-public-key
JWT_ACCESS_TOKEN_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_SOCIAL_REDIRECT_URI=http://localhost:8080/login/social?access_token=%s&role=%s

# ────────────────────────────────────────────
# OAuth2
# ────────────────────────────────────────────
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao

NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_REDIRECT_URI=http://localhost:8080/login/oauth2/code/naver

OAUTH_FAILURE_REDIRECT_URI=http://localhost:8080/login

# ────────────────────────────────────────────
# LiveKit (OpenVidu)
# ────────────────────────────────────────────
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_SECRET=your-livekit-secret

# ────────────────────────────────────────────
# GMS API
# ────────────────────────────────────────────
GMS_API_BASE_URL=http://your-gms-api-url
GMS_API_KEY=your-gms-api-key

# ────────────────────────────────────────────
# Service URLs
# ────────────────────────────────────────────
USER_SERVICE_URL=http://localhost:8082

# ────────────────────────────────────────────
# Monitoring (docker-compose.monitoring.yml)
# ────────────────────────────────────────────

# Zipkin - 분산 트레이싱
# 로컬 실행 시 기본값(http://localhost:9411)이 사용되므로 생략 가능
ZIPKIN_URL=http://localhost:9411

# Grafana 접속 계정 (기본값: admin / admin)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Discord 알림 Webhook URL
# Discord 서버 → 채널 편집 → 연동 → 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Email 알림 (critical 알림만 발송)
# Gmail 사용 시: 앱 비밀번호(2단계 인증 필요)로 설정
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_USERNAME=your-email@gmail.com
ALERT_SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=your-alert-recipient@gmail.com

# ============================================
# Rate Limit Bypass IPs (k6 부하 테스트용)
# k6 컨테이너 IP를 콤마로 구분하여 입력
# 예: RATE_LIMIT_BYPASS_IPS=172.18.0.5,172.20.0.1
# 비어있으면 bypass 없음 (기본값)
RATE_LIMIT_BYPASS_IPS=
