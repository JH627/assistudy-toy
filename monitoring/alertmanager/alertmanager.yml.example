# Alertmanager 설정 템플릿

global:
  resolve_timeout: 5m
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: 'REPLACE_WITH_SENDER_EMAIL'         # 예: alerts@gmail.com
  smtp_auth_username: 'REPLACE_WITH_SMTP_EMAIL'  # 예: alerts@gmail.com
  smtp_auth_password: 'REPLACE_WITH_APP_PASSWORD' # Gmail 앱 비밀번호 (2단계 인증 필요)
  smtp_require_tls: true

route:
  receiver: discord-only
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 1h
  routes:
    # critical → Discord + Email
    - matchers:
        - severity="critical"
      receiver: discord-and-email
      repeat_interval: 30m

    # warning → Discord만
    - matchers:
        - severity="warning"
      receiver: discord-only

receivers:
  - name: discord-and-email
    discord_configs:
      - webhook_url: 'REPLACE_WITH_DISCORD_WEBHOOK_URL'
        # Discord: 서버 설정 → 연동 → 웹후크 → URL 복사
        title: '🚨 [CRITICAL] {{ .GroupLabels.alertname }}'
        message: |
          {{ range .Alerts }}
          **서비스**: {{ .Labels.job }}
          **요약**: {{ .Annotations.summary }}
          **상세**: {{ .Annotations.description }}
          **발생시각**: {{ .StartsAt.Format "2006-01-02 15:04:05" }}
          {{ end }}
    email_configs:
      - to: 'REPLACE_WITH_RECIPIENT_EMAIL'  # 알림 수신 이메일
        send_resolved: true
        headers:
          Subject: '[CRITICAL] {{ .GroupLabels.alertname }} - Assistudy Alert'

  - name: discord-only
    discord_configs:
      - webhook_url: 'REPLACE_WITH_DISCORD_WEBHOOK_URL'
        title: '⚠️ [WARNING] {{ .GroupLabels.alertname }}'
        message: |
          {{ range .Alerts }}
          **서비스**: {{ .Labels.job }}
          **요약**: {{ .Annotations.summary }}
          **상세**: {{ .Annotations.description }}
          {{ end }}

# critical이 발생하면 동일 서비스의 warning 알림 억제
inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal:
      - job
